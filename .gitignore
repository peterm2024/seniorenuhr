# ESP-IDF
build/
# Getrenntes Verzeichnis fuer Produktions-Builds (Board 2): so bleibt der
# Entwicklungs-Build daneben bestehen, statt bei jedem Wechsel neu zu bauen.
#   $env:PRODUKTIONS_BUILD = "1"; idf.py -B build_prod -p COM5 flash
build_prod/
managed_components/
sdkconfig
sdkconfig.old
dependencies.lock

# Heruntergeladene Schriftdatei und kompilierte Tests
tools/fonts/*.ttf
test_host/*.exe

# IDE / OS
.vscode/settings.json
Thumbs.db
*.tmp

# Geheimnisse (WLAN-Zugang, Kalender-URL) niemals einchecken
secrets.h
*.secret

# lokal heruntergeladener Kalender (enthaelt private Termine)
kalender.ics

# Python-Bytecode (z.B. vom Testen des Screenshot-Dekodier-Skripts)
__pycache__/

# Serielle Boot-/Monitor-Mitschnitte (idf.py monitor > datei.log) - immer
# temporaer fuers Debugging, nie fuer den Commit gedacht
*.log

# Sammelordner fuer ALLE vom Geraet abgeholten Bildschirmfotos (Standardziel
# von tools/screenshot_flash_abholen.py, je Board ein Unterordner). Bleibt
# bewusst lokal: hier landet ungefiltert alles, was gerade auf dem Schirm
# stand - auch echte Termine und Tablettennamen von den Eltern. Was in die
# Doku soll, wird von Hand nach docs/screenshots/ kopiert (das ist eingecheckt).
screenshots_lokal/
